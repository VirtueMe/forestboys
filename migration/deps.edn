{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        cheshire/cheshire   {:mvn/version "5.13.0"}}

 :aliases
 {:dev
  {:extra-paths ["dev" "notebooks"]
   :extra-deps  {djblue/portal              {:mvn/version "0.58.5"}
                 io.github.nextjournal/clerk {:mvn/version "0.17.1102"}}}

  ;; Run round-0 as a script:  clj -M:run
  :run
  {:main-opts ["-m" "linge.round-zero"]}

  ;; Run round-1 as a script:  clj -M:run-1
  :run-1
  {:main-opts ["-m" "linge.round-one"]}

  ;; Run round-1.5 (pages CMS migration):  clj -M:run-1-5
  :run-1-5
  {:main-opts ["-m" "linge.pages"]}

  ;; Export page bundles for the Vue consumer:  clj -M:export-pages
  :export-pages
  {:main-opts ["-m" "linge.export-pages"]}

  ;; Round 2 — classify 29 outlines into Unit/Operation/EquipmentType/Source/Article
  :run-2
  {:main-opts ["-m" "linge.outlines"]}

  ;; Round 2.1 — Kompani Linge's 30 training courses (from the outline table)
  :run-2-1
  {:main-opts ["-m" "linge.courses"]}

  ;; Indexes + unique constraints — idempotent, safe to re-run
  :indexes
  {:main-opts ["-m" "linge.indexes"]}}}

;; Notes:
;; - Versions above are reasonable recent choices. Verify/bump as needed.
;; - Calva "Jack-in" injects cider-nrepl middleware automatically — no :nrepl alias needed.
;; - Pick the :dev alias in the jack-in dialog to include Portal and Clerk.
