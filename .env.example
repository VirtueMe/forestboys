# Sanity project credentials
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# Neo4j Aura — read-only user for browser queries (VITE_ prefix exposes to frontend)
VITE_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
VITE_NEO4J_READER=milorg_reader
VITE_NEO4J_READER_PASSWORD=your-readonly-password

# Neo4j Aura — admin user for import scripts only (never exposed to browser)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-admin-password

# Local bot runner (scripts/bot/local-runner.ts) — smoke-test the proposal
# pipeline without GitHub Actions. Match BOT_INGEST_SECRET to CF dev's
# .dev.vars. Leave PROPOSAL_INGEST_URL empty unless your local CF dev
# port differs from 8788.
BOT_INGEST_SECRET=local-dev-secret
PROPOSAL_INGEST_URL=http://localhost:8788/api/proposals/ingest
