{
  "name": "milorg",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "node scripts/tools/dev-worker.ts",
    "dev:bot": "tsx scripts/bot/local-runner.ts",
    "dev:do": "wrangler dev --config workers/bundle-events/wrangler.toml --port 8790",
    "deploy:do": "wrangler deploy --config workers/bundle-events/wrangler.toml",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:design": "npx tsx scripts/design/check.ts",
    "test": "vitest run",
    "test:neo4j": "NEO4J_TEST=1 vitest run --no-file-parallelism functions/api/admin/proposals/_apply.neo4j.test.ts scripts/lib/outline-conversion.neo4j.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:record": "tsx scripts/e2e/record-fixtures.ts",
    "prepare": "husky",
    "prompts:test": "tsx scripts/prompts/test.ts",
    "pull:graph": "tsx scripts/tools/pull-production.ts",
    "pull:bundles": "tsx scripts/tools/pull-production-r2.ts"
  },
  "dependencies": {
    "@portabletext/editor": "^6.6.2",
    "dotenv": "^18.0.5",
    "idb": "^8.0.3",
    "less": "^4.6.4",
    "maplibre-gl": "^6.12.0",
    "neo4j-driver": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "spdx-license-ids": "^3.0.23",
    "vite-plugin-pwa": "^1.2.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.4",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.83.0",
    "yargs": "^18.0.0"
  }
}
