{
  "name": "milorg",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "node scripts/tools/dev-worker.ts",
    "dev:bot": "tsx scripts/bot/local-runner.ts",
    "dev:do": "wrangler dev --config workers/bundle-events/wrangler.toml --port 8790",
    "deploy:do": "wrangler deploy --config workers/bundle-events/wrangler.toml",
    "dev:images": "wrangler dev --config workers/image-maker/wrangler.toml --port 8791",
    "deploy:images": "wrangler deploy --config workers/image-maker/wrangler.toml",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:design": "npx tsx scripts/design/check.ts",
    "test": "vitest run",
    "test:neo4j": "NEO4J_TEST=1 vitest run --no-file-parallelism functions/api/admin/proposals/_apply.neo4j.test.ts scripts/lib/outline-conversion.neo4j.test.ts functions/_lib/slug-rename.neo4j.test.ts scripts/lib/place-sync.neo4j.test.ts scripts/lib/transport-sync.neo4j.test.ts scripts/lib/link-sync.neo4j.test.ts scripts/lib/org-sync.neo4j.test.ts scripts/lib/event-people-order.neo4j.test.ts scripts/lib/event-create-order.neo4j.test.ts scripts/lib/event-transport-order.neo4j.test.ts scripts/lib/member-order.neo4j.test.ts scripts/lib/event-people-list.neo4j.test.ts scripts/lib/outline-sync.neo4j.test.ts scripts/lib/image-backfill-graph.neo4j.test.ts scripts/lib/sanity-image.neo4j.test.ts functions/_lib/entity-images.neo4j.test.ts functions/api/admin/outline/[slug]/people.neo4j.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:record": "tsx scripts/e2e/record-fixtures.ts",
    "prepare": "husky",
    "prompts:test": "tsx scripts/prompts/test.ts",
    "pull:graph": "tsx scripts/tools/pull-production.ts",
    "pull:bundles": "tsx scripts/tools/pull-production-r2.ts"
  },
  "dependencies": {
    "@portabletext/editor": "^8.2.11",
    "dotenv": "^18.0.9",
    "idb": "^8.0.4",
    "less": "^4.6.4",
    "maplibre-gl": "^6.16.0",
    "neo4j-driver": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spdx-license-ids": "^3.0.23",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.157.0",
    "yargs": "^18.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
