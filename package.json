{
  "name": "milorg",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler pages dev --do BUNDLE_EVENTS=BundleEventsDO@milorg-bundle-events -- npm run dev",
    "dev:bot": "tsx scripts/bot/local-runner.ts",
    "dev:do": "wrangler dev --config workers/bundle-events/wrangler.toml --port 8790",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "prompts:test": "tsx scripts/prompts/test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@knight-lab/timelinejs": "^3.9.13",
    "@portabletext/editor": "^6.6.2",
    "dotenv": "^17.4.1",
    "idb": "^8.0.3",
    "less": "^4.9.1",
    "maplibre-gl": "^5.22.0",
    "neo4j-driver": "^6.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spdx-license-ids": "^3.0.24",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260413.1",
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.146.0",
    "yargs": "^18.2.0"
  }
}
