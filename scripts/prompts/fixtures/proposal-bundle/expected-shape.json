{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "proposal-bundle output",
  "oneOf": [
    {
      "type": "object",
      "required": ["bundleId", "outlineId", "outlineRev", "summary", "createdAt", "model", "promptHash", "entities"],
      "properties": {
        "bundleId":   { "type": "string", "pattern": "^bundle:[a-z0-9-]+:[0-9TZ:.-]+$" },
        "outlineId":  { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "outlineRev": { "type": "string", "minLength": 1 },
        "summary":    { "type": "string", "minLength": 1 },
        "createdAt":  { "type": "string", "format": "date-time" },
        "model":      { "type": "string", "minLength": 1 },
        "promptHash": { "type": "string", "minLength": 1 },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["entityId", "ops", "derivedFrom"],
            "properties": {
              "entityId":  { "type": "string", "pattern": "^[A-Z][A-Za-z]+:[a-z0-9-]+$" },
              "ops": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["op"],
                  "properties": {
                    "op": {
                      "enum": [
                        "create-entity",
                        "modify-block",
                        "add-edge",
                        "remove-edge",
                        "delete-entity",
                        "obsolete-outline"
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if":  { "properties": { "op": { "const": "create-entity" } } },
                      "then": {
                        "required": ["kind", "slug", "props"],
                        "properties": {
                          "kind":  { "type": "string" },
                          "slug":  { "type": "string", "pattern": "^[a-z0-9-]+$" },
                          "props": { "type": "object" },
                          "edges": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": ["type", "to"],
                              "properties": {
                                "type":  { "type": "string", "minLength": 1 },
                                "to":    { "type": "string", "pattern": "^[A-Z][A-Za-z]+:[a-z0-9-]+$" },
                                "props": { "type": "object" }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "if":  { "properties": { "op": { "const": "modify-block" } } },
                      "then": {
                        "required": ["blockPath", "expectedSha", "newValue"],
                        "properties": {
                          "blockPath":   { "type": "string", "pattern": "^section\\.[a-z0-9-]+\\.block\\.[A-Za-z0-9_-]+$" },
                          "expectedSha": { "type": "string" },
                          "newValue": {
                            "type": "object",
                            "required": ["_type", "children"],
                            "properties": {
                              "_type":    { "const": "block" },
                              "children": { "type": "array", "minItems": 1 }
                            }
                          }
                        }
                      }
                    },
                    {
                      "if":  { "properties": { "op": { "const": "add-edge" } } },
                      "then": {
                        "required": ["type", "from", "to"],
                        "properties": {
                          "type":  { "type": "string", "minLength": 1 },
                          "from":  { "type": "string", "pattern": "^[A-Z][A-Za-z]+:[a-z0-9-]+$" },
                          "to":    { "type": "string", "pattern": "^[A-Z][A-Za-z]+:[a-z0-9-]+$" },
                          "props": { "type": "object" }
                        }
                      }
                    },
                    {
                      "if":  { "properties": { "op": { "const": "remove-edge" } } },
                      "then": {
                        "required": ["type", "from", "to"],
                        "properties": {
                          "type": { "type": "string", "minLength": 1 },
                          "from": { "type": "string", "pattern": "^[A-Z][A-Za-z]+:[a-z0-9-]+$" },
                          "to":   { "type": "string", "pattern": "^[A-Z][A-Za-z]+:[a-z0-9-]+$" }
                        }
                      }
                    },
                    {
                      "if":  { "properties": { "op": { "const": "obsolete-outline" } } },
                      "then": {
                        "required": ["reason"],
                        "properties": {
                          "reason": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  ]
                }
              },
              "derivedFrom": {
                "type": "object",
                "required": ["outlineId", "outlineRev"],
                "properties": {
                  "outlineId":   { "type": "string", "pattern": "^[a-z0-9-]+$" },
                  "outlineRev":  { "type": "string", "minLength": 1 },
                  "sectionPath": { "type": "string" }
                }
              },
              "source":      { "type": "string" },
              "generatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["skip", "reason"],
      "properties": {
        "skip":   { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  ]
}
