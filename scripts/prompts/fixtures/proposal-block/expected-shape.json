{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "proposal-block output",
  "oneOf": [
    {
      "type": "object",
      "required": ["entityId", "blockPath", "newValue", "derivedFrom", "model", "generatedAt", "promptHash"],
      "properties": {
        "entityId":    { "type": "string", "minLength": 1 },
        "blockPath":   { "type": "string", "minLength": 1 },
        "newValue": {
          "type": "object",
          "required": ["_type", "children"],
          "properties": {
            "_type":    { "const": "block" },
            "children": { "type": "array", "minItems": 1 }
          },
          "additionalProperties": true
        },
        "derivedFrom": {
          "type": "object",
          "required": ["outlineId", "sectionPath", "outlineRev"],
          "properties": {
            "outlineId":   { "type": "string", "minLength": 1 },
            "sectionPath": { "type": "string", "minLength": 1 },
            "outlineRev":  { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "model":       { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "promptHash":  { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["skip", "reason"],
      "properties": {
        "skip":   { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  ]
}
